{
  "name": "mydevsaid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-backed investigations of on-chain and off-chain project claims.",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.ts",
    "headless": "node --env-file-if-exists=.env src/cli.ts --headless",
    "serve": "node --env-file-if-exists=.env src/server.ts",
    "investigate": "node --env-file-if-exists=.env src/engine.ts",
    "plan": "node src/investigation.ts",
    "discover": "node src/discovery.ts",
    "test": "node --test --test-reporter=tap src/*.test.ts public/*.test.js",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --noUnusedLocals --noUnusedParameters --noUncheckedIndexedAccess --exactOptionalPropertyTypes --target ES2023 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions src/*.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@crawlee/basic": "3.18.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0",
    "marked": "18.0.5",
    "playwright": "1.63.0",
    "stripe": "22.6.2",
    "tldts": "7.4.13",
    "typebox": "1.3.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "5.9.3"
  }
}
