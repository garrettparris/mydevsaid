# Personal workspace: copy this file to .env, then npm start.
LOCAL_MODE=true
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Optional for legacy administration; personal chat does not need a key.
ADMIN_TOKEN=
DATABASE_PATH=data/mydevsaid.sqlite
# Exact socket IPs of your reverse proxy only; proxy must append/overwrite X-Forwarded-For.
TRUST_PROXY_IPS=

# Pi uses the OpenAI API, with server-side credentials.
OPENAI_API_KEY=
PI_MODEL=gpt-5.3-codex

# Optional GMGN metadata, security, pool and top-100 wallet queries.
# Uses the existing ~/.config/gmgn/.env API key when this variable is absent.
# Uncomment with an empty value to disable GMGN, or supply a server-side API key.
# GMGN_API_KEY=
# No trading/signing key is used. Queries share a five-weight-units/second budget.

# Legacy hosted billing only. Unused by the personal workspace.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional public HTTPS RPC overrides. Ethereum/Base default to PublicNode.
MYDEVSAID_RPC_1=
MYDEVSAID_RPC_8453=
# Robinhood defaults to its official mainnet RPC.
MYDEVSAID_RPC_4663=

# Optional, comma-separated published report IDs. Empty disables monitoring.
MONITOR_REPORT_IDS=
MONITOR_INTERVAL_HOURS=24
